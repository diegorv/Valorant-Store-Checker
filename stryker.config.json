{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",

  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "configFile": "vitest.stryker.config.ts"
  },

  "_comment_coverageAnalysis": "perTest faz o Stryker rodar, para cada mutante, só os testes que passam por aquela linha. É o que torna a rodada viável.",
  "coverageAnalysis": "perTest",

  "_comment_concurrency": "O default é (núcleos - 1), o que numa máquina de 10 núcleos derruba o desktop. 4 é o que o runner do GitHub tem e é suficiente.",
  "concurrency": 4,

  "_comment_mutate": "Mesmo recorte do coverage em vitest.config.ts: só o que o projeto considera unit-testável.",
  "mutate": [
    "src/lib/**/*.ts",
    "src/app/api/**/*.ts",
    "src/middleware.ts",
    "!src/**/__tests__/**",
    "!src/lib/msw/**",
    "!src/lib/db.ts",
    "!src/lib/env.ts",
    "!src/lib/nav.ts",
    "!src/lib/redis-client.ts",
    "!src/lib/rate-limiter.ts",
    "!src/lib/session-db.ts",
    "!src/lib/session-crypto.ts",
    "!src/lib/inventory-cache.ts",
    "!src/lib/store-history.ts",
    "!src/lib/store-service.ts",
    "!src/lib/riot-reauth.ts",
    "!src/lib/riot-inventory.ts",
    "!src/lib/riot-loadout.ts",
    "!src/lib/henrik-api.ts",
    "!src/lib/edition-icons.ts",
    "!src/lib/auth-handlers/index.ts",
    "!src/app/api/accounts/**",
    "!src/app/api/inventory/**",
    "!src/app/api/profile/**",
    "!src/app/api/wishlist/**"
  ],

  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },

  "_comment_thresholds": "break: null — por enquanto só medimos. Definir um break depois de algumas rodadas estáveis.",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },

  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
